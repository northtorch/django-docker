# /etc/django-docker.env の例（systemd の EnvironmentFile として読み込む）
# SECRET_KEY は uv run python get_random_secret_key.py で作った値に置き換える
# example.com は、自分のサーバのドメイン名に置き換える
SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_STATIC_ROOT=/var/www/django-docker/static
