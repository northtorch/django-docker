# -----------------------------------------------------------------------------
# local_settings.py for production environment (server / docker)
#
# サーバと Docker のどちらでも、このファイルを local_settings.py としてコピーして使う。
# 環境ごとに変わる値は、環境変数（または /run/secrets/<名前>）から読み込む。
#
#   SECRET_KEY                  必須。get_random_secret_key.py で作る
#   DJANGO_ALLOWED_HOSTS        アクセスを受け付けるドメイン名（カンマ区切り）
#   DJANGO_CSRF_TRUSTED_ORIGINS https でフォームを送るときの送信元（カンマ区切り。例: https://example.com）
#   DJANGO_DB_DIR               SQLite のファイルを置くディレクトリ
#   DJANGO_LOG_DIR              ログを置くディレクトリ
#   DJANGO_STATIC_ROOT          collectstatic で静的ファイルを集めるディレクトリ
# -----------------------------------------------------------------------------
import os

FILE_BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def manage_sensitive(name):
    """環境変数 または /run/secrets から秘密情報を読み込む
    """
    v1 = os.getenv(name)
    if v1 is not None:
        return v1

    secret_fpath = f'/run/secrets/{name}'
    existence = os.path.exists(secret_fpath)
    if existence:
        with open(secret_fpath, mode='r') as f:
            v2 = f.read().rstrip('\n')
        return v2
    return None


def env_list(name, default):
    """カンマ区切りの環境変数をリストにする
    """
    value = os.getenv(name, default)
    return [v.strip() for v in value.split(',') if v.strip()]


DEBUG = False

# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY = manage_sensitive('SECRET_KEY')

ALLOWED_HOSTS = env_list('DJANGO_ALLOWED_HOSTS', 'localhost,127.0.0.1')  # サイトドメイン(またはIPアドレス)

CSRF_TRUSTED_ORIGINS = env_list('DJANGO_CSRF_TRUSTED_ORIGINS', '')

ADMINS = (
    ('admin', 'admin@northtorch.co.jp'),
)

DATABASES = {
    'default': {
        'ENGINE': 'django.db.backends.sqlite3',
        'NAME': os.path.join(os.getenv('DJANGO_DB_DIR', os.path.join(FILE_BASE_DIR, 'db')), 'db.sqlite3'),
    }
}

LOGPATH = os.path.join(os.getenv('DJANGO_LOG_DIR', os.path.join(FILE_BASE_DIR, 'log')), 'django.log')

LOGGING = {
    'version': 1,
    'disable_existing_loggers': False,
    'formatters': {
        'simple': {
            'format': '[%(asctime)s] %(levelname)s %(message)s'
        },
        'detail': {
            'format': '[%(asctime)s] {%(pathname)s:%(lineno)d} %(levelname)s %(message)s',
        }
    },
    'handlers': {
        'console': {
            'level': 'DEBUG',
            'class': 'logging.StreamHandler',
            'formatter': 'simple'
        },
        'file': {
            'formatter': 'detail',
            'level': 'DEBUG',
            'class': 'logging.handlers.TimedRotatingFileHandler',
            'filename': LOGPATH,
            'when': 'W0',
            'interval': 1,
            'backupCount': 8,
            'encoding': 'utf8',
        },
    },
    'loggers': {
        'app': {
            'handlers': ['file', 'console'],
            'level': 'DEBUG',
            'propagate': False,
        },
    }
}

STATIC_ROOT = os.getenv('DJANGO_STATIC_ROOT', os.path.join(FILE_BASE_DIR, 'staticfiles'))
